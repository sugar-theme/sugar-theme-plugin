{
  "mcpServers": {
    "sugar-theme": {
      "type": "http",
      "url": "https://app.sugarthe.me/api/mcp",
      "oauth": {
        "clientId": "TW7DqLOYRnvp3U6n",
        "callbackPort": 47219
      }
    },
    "playwright": {
      "command": "bash",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/playwright-mcp.sh",
        "--headless",
        "--browser",
        "chromium",
        "--output-dir",
        "/tmp/playwright-mcp"
      ]
    },
    "playwright-safari": {
      "command": "bash",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/playwright-mcp.sh",
        "--headless",
        "--browser",
        "webkit",
        "--output-dir",
        "/tmp/playwright-mcp"
      ]
    }
  }
}
